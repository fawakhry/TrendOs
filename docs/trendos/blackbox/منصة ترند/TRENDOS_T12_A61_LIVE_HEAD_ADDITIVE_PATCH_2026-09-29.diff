+function trendosEmployeeLegacyBridgeEnabledV1_() {
+  try {
+    return normalize_(PropertiesService.getScriptProperties().getProperty("TRENDOS_EMPLOYEE_LEGACY_BRIDGE_V1_ENABLED")).toLowerCase() === "true";
+  } catch (err) {
+    return false;
+  }
+}
