+function trendosEmployeeLegacyBridgeSecretV1_() {
+  try {
+    return String(PropertiesService.getScriptProperties().getProperty("EMPLOYEE_LEGACY_BRIDGE_SECRET_V1") || "");
+  } catch (err) {
+    return "";
+  }
+}
